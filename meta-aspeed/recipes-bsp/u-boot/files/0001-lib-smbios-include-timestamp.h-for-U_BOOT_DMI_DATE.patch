From b16f2b42d060ae8a6d2a45f7a6bd3e6f3ec8451d Mon Sep 17 00:00:00 2001
From: Mengjie Ji <jmj442930425@google.com>
Date: Thu, 4 Jun 2026 00:00:00 +0000
Subject: [PATCH] lib: smbios: include timestamp.h for U_BOOT_DMI_DATE

smbios_write_type0() references U_BOOT_DMI_DATE, which is defined in
include/generated/timestamp_autogenerated.h and only exposed through
<timestamp.h>. smbios.c includes <version.h>, which no longer pulls in
the timestamp header, so building with CONFIG_GENERATE_SMBIOS_TABLE
fails:

  lib/smbios.c:84:58: error: 'U_BOOT_DMI_DATE' undeclared
                              (first use in this function)

Include <timestamp.h> explicitly so the macro is visible.

Upstream-Status: Pending

Signed-off-by: Mengjie Ji <jmj442930425@google.com>
---
 lib/smbios.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/lib/smbios.c b/lib/smbios.c
index e8ee55c4ae..e6002e85f1 100644
--- a/lib/smbios.c
+++ b/lib/smbios.c
@@ -9,6 +9,7 @@
 #include <mapmem.h>
 #include <smbios.h>
 #include <tables_csum.h>
+#include <timestamp.h>
 #include <version.h>
 #ifdef CONFIG_CPU
 #include <cpu.h>
--
